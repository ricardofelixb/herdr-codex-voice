+// Modified for the Herdr Codex Voice community canary; see HERDR_VOICE_CANARY_CHANGES.md.
+use super::*;
+use crate::api::schema::{
+    Method, PaneLastInput, PaneTarget, Request, ResponseResult, SuccessResponse,
+};
+use crate::protocol::{ClientKeyCode, ClientKeyKind, ClientPaneInputEvent};
+
+fn setup() -> (
+    HeadlessServer,
+    Vec<String>,
+    Vec<tokio::sync::mpsc::Receiver<Bytes>>,
+) {
+    let mut server = test_headless_server();
+    let mut workspace = crate::workspace::Workspace::test_new("input-origin");
+    let first = workspace.tabs[0].root_pane;
+    let second = workspace.test_split(ratatui::layout::Direction::Horizontal);
+    server.app.state.workspaces = vec![workspace];
+    server.app.state.ensure_test_terminals();
+    server.app.state.active = Some(0);
+    server.app.state.selected = 0;
+    server.app.state.mode = crate::app::Mode::Terminal;
+    let mut receivers = Vec::new();
+    let mut panes = Vec::new();
+    for pane in [first, second] {
+        let terminal = server.app.state.workspaces[0]
+            .terminal_id(pane)
+            .unwrap()
+            .clone();
+        let (runtime, receiver) =
+            crate::terminal::TerminalRuntime::test_with_channel_capacity(80, 24, 32);
+        server.app.terminal_runtimes.insert(terminal, runtime);
+        receivers.push(receiver);
+        panes.push(server.app.public_pane_id(0, pane).unwrap());
+    }
+    for (id, connection) in [
+        (1, "127.0.0.1 1111 100.1.2.3 22"),
+        (2, "127.0.0.1 2222 100.1.2.3 22"),
+    ] {
+        let mut client = ClientConnection::new(
+            (80, 24),
+            Default::default(),
+            id,
+            RenderEncoding::SemanticFrame,
+            None,
+        );
+        client.origin = Some(Arc::new(protocol::endpoint::EndpointClientOrigin {
+            via: "ssh_bridge".into(),
+            ssh_connection: Some(connection.into()),
+        }));
+        server.clients.insert(id, client);
+    }
+    (server, panes, receivers)
+}
+
+fn input(server: &mut HeadlessServer, client_id: u64, pane_id: &str, event: ClientPaneInputEvent) {
+    server.handle_server_event(ServerEvent::ClientShellPaneInput {
+        client_id,
+        pane_id: pane_id.into(),
+        events: vec![event],
+    });
+}
+
+fn request(server: &mut HeadlessServer, method: Method) -> serde_json::Value {
+    let (respond_to, response) = std::sync::mpsc::channel();
+    server.handle_api_request_with_shutdown_check(api::ApiRequestMessage {
+        request: Request {
+            id: "input-origin-test".into(),
+            method,
+        },
+        respond_to,
+        response_write_complete: None,
+    });
+    serde_json::from_str(&response.recv().unwrap()).unwrap()
+}
+
+fn last_input(server: &mut HeadlessServer, pane: &str) -> Option<PaneLastInput> {
+    let response = request(
+        server,
+        Method::PaneLastInput(PaneTarget {
+            pane_id: pane.into(),
+        }),
+    );
+    let response: SuccessResponse = serde_json::from_value(response).unwrap();
+    let ResponseResult::PaneLastInput {
+        pane_id,
+        terminal_id,
+        last_input,
+    } = response.result
+    else {
+        panic!("expected pane last input");
+    };
+    assert_eq!(pane_id, pane);
+    assert!(terminal_id.starts_with("term_"));
+    last_input
+}
+
+fn key(kind: ClientKeyKind) -> ClientPaneInputEvent {
+    client_page_key(
+        ClientKeyCode::Char('x'),
+        crossterm::event::KeyModifiers::empty(),
+        kind,
+    )
+}
