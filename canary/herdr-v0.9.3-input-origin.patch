+// Modified for the Herdr Codex Voice community canary; see HERDR_VOICE_CANARY_CHANGES.md.
+use super::*;
+use crate::api::schema::{
+    Method, PaneInputSource, PaneLastInput, PaneLastInputClient, ResponseResult,
+};
+use crate::protocol::endpoint::EndpointClientOrigin;
+use crate::protocol::{ClientKeyKind, ClientPaneInputEvent};
+
+#[derive(Default)]
+pub(super) struct InputOrigins {
+    sequence: u64,
+    terminals: HashMap<String, LastInput>,
+}
+
+struct LastInput {
+    seq: u64,
+    kind: &'static str,
+    client: Option<(u64, Option<Arc<EndpointClientOrigin>>)>,
+}
+
+impl InputOrigins {
+    #[cfg(test)]
+    pub(super) fn is_empty(&self) -> bool {
+        self.terminals.is_empty()
+    }
+
+    pub(super) fn record(
+        &mut self,
+        terminal_id: &str,
+        kind: &'static str,
+        client: Option<(u64, Option<Arc<EndpointClientOrigin>>)>,
+    ) {
+        self.sequence = self.sequence.saturating_add(1);
+        let input = LastInput {
+            seq: self.sequence,
+            kind,
+            client,
+        };
+        if let Some(previous) = self.terminals.get_mut(terminal_id) {
+            *previous = input;
+        } else {
+            self.terminals.insert(terminal_id.to_owned(), input);
+        }
+    }
+
+    fn get(
+        &self,
+        terminal_id: &str,
+        clients: &HashMap<u64, ClientConnection>,
+    ) -> Option<PaneLastInput> {
+        let input = self.terminals.get(terminal_id)?;
+        Some(PaneLastInput {
+            seq: input.seq,
+            kind: input.kind.into(),
+            source: if input.client.is_some() {
+                PaneInputSource::Client
+            } else {
+                PaneInputSource::Api
+            },
+            client: input
+                .client
+                .as_ref()
+                .map(|(client_id, origin)| PaneLastInputClient {
+                    connected: clients.contains_key(client_id),
+                    via: origin
+                        .as_ref()
+                        .map_or("unknown", |origin| origin.via.as_str())
+                        .into(),
+                    ssh_connection: origin
+                        .as_ref()
+                        .and_then(|origin| origin.ssh_connection.clone()),
+                }),
+        })
+    }
+}
+
+/// One lookup/update per accepted batch, with no scans or per-keystroke string copies.
+pub(super) fn input_kind(events: &[ClientPaneInputEvent]) -> Option<&'static str> {
+    events.iter().rev().find_map(|event| match event {
+        ClientPaneInputEvent::Key {
+            kind: ClientKeyKind::Press | ClientKeyKind::Repeat,
+            ..
+        } => Some("key"),
+        ClientPaneInputEvent::TextCommit(text) if !text.is_empty() => Some("text_commit"),
+        ClientPaneInputEvent::Paste(text) if !text.is_empty() => Some("paste"),
+        _ => None,
+    })
+}
+
+impl HeadlessServer {
+    pub(super) fn prune_input_origins(&mut self) {
+        self.terminal_last_input
+            .terminals
+            .retain(|terminal_id, _| self.app.state.terminals.contains_key(terminal_id.as_str()));
+    }
+
+    pub(super) fn handle_pane_last_input_api(&mut self, id: String, pane_id: &str) -> String {
+        self.prune_input_origins();
+        let terminal_id = self
+            .app
+            .parse_pane_id(pane_id)
+            .and_then(|(workspace_index, pane_id)| {
+                self.app
+                    .state
+                    .workspaces
+                    .get(workspace_index)?
+                    .terminal_id(pane_id)
+            });
+        let Some(terminal_id) = terminal_id else {
+            return crate::server::client_commands::error_response(
+                id,
+                "pane_not_found",
+                format!("pane {pane_id} not found"),
+            );
+        };
+        serde_json::to_string(&api::schema::SuccessResponse {
+            id,
+            result: ResponseResult::PaneLastInput {
+                pane_id: pane_id.to_owned(),
+                terminal_id: terminal_id.to_string(),
+                last_input: self
+                    .terminal_last_input
+                    .get(terminal_id.as_str(), &self.clients),
+            },
+        })
+        .expect("input attribution contains only JSON-safe values")
+    }
+
+    pub(super) fn record_api_input(&mut self, method: &Method) {
+        let (target, kind) = match method {
+            Method::PaneSendText(params) => (self.app.parse_pane_id(&params.pane_id), "send_text"),
+            Method::PaneSendKeys(params) => (self.app.parse_pane_id(&params.pane_id), "send_keys"),
+            Method::PaneSendInput(params) => {
+                (self.app.parse_pane_id(&params.pane_id), "send_input")
+            }
+            Method::AgentStart(params) => (self.app.parse_pane_id(&params.pane_id), "agent_start"),
+            Method::AgentPrompt(params) => (
+                self.app
+                    .resolve_agent_target(&params.target)
+                    .ok()
+                    .map(|resolved| (resolved.ws_idx, resolved.pane_id)),
+                "agent_prompt",
+            ),
+            Method::AgentSendKeys(params) => (
+                self.app
+                    .resolve_agent_target(&params.target)
+                    .ok()
+                    .map(|resolved| (resolved.ws_idx, resolved.pane_id)),
+                "agent_send_keys",
+            ),
+            _ => return,
+        };
+        if let Some(terminal_id) = target.and_then(|(workspace_index, pane_id)| {
+            self.app
+                .state
+                .workspaces
+                .get(workspace_index)?
+                .terminal_id(pane_id)
+        }) {
+            self.terminal_last_input
+                .record(terminal_id.as_str(), kind, None);
+        }
+    }
+}
