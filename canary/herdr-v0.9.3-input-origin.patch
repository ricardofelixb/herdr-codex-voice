+    );
+    shutdown_test_runtimes(&mut server);
+}
+
+#[tokio::test]
+async fn input_origin_two_clients_and_panes_follow_actual_keyboard_input() {
+    let (mut server, panes, _receivers) = setup();
+    assert!(last_input(&mut server, &panes[0]).is_none());
+    input(&mut server, 1, &panes[0], key(ClientKeyKind::Press));
+    let first = last_input(&mut server, &panes[0]).unwrap();
+    input(
+        &mut server,
+        2,
+        &panes[1],
+        ClientPaneInputEvent::Paste("paste".into()),
+    );
+    let second = last_input(&mut server, &panes[1]).unwrap();
+    assert!(second.seq > first.seq);
+    assert_ne!(first.client, second.client);
+    assert_eq!(last_input(&mut server, &panes[0]), Some(first.clone()));
+
+    input(&mut server, 2, &panes[0], key(ClientKeyKind::Release));
+    input(
+        &mut server,
+        2,
+        &panes[0],
+        ClientPaneInputEvent::Mouse {
+            kind: protocol::ClientMouseKind::Moved,
+            position: protocol::ClientMousePosition::Cell { column: 1, row: 1 },
+            geometry: None,
+            modifiers: 0,
+            lines: 0,
+        },
+    );
+    server.promote_client_to_foreground(2);
+    assert_eq!(last_input(&mut server, &panes[0]), Some(first));
+    input(&mut server, 2, &panes[0], key(ClientKeyKind::Repeat));
+    let repeated = last_input(&mut server, &panes[0]).unwrap();
+    assert_eq!(repeated.client, second.client);
+    assert!(repeated.seq > second.seq);
+    input(
+        &mut server,
+        1,
+        &panes[0],
+        ClientPaneInputEvent::TextCommit("ime".into()),
+    );
+    assert_eq!(
+        last_input(&mut server, &panes[0]).unwrap().kind,
+        "text_commit"
+    );
+    shutdown_test_runtimes(&mut server);
+}
