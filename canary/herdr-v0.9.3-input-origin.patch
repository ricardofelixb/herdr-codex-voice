+
+    #[test]
+    fn input_origin_stdin_child() {
+        if std::env::var_os("HERDR_INPUT_ORIGIN_STDIN_TEST").is_none() {
+            return;
+        }
+        // Fill the process-wide buffer, then release its lock before the
+        // handshake and upload worker obtain their own Stdin handles.
+        assert!(!std::io::BufRead::fill_buf(&mut io::stdin().lock())
+            .unwrap()
+            .is_empty());
+        let first = read_bridge_hello(&mut io::stdin(), None).unwrap().unwrap();
+        assert!(matches!(first, ClientMessage::TerminalHello { .. }));
+        let next = std::thread::spawn(|| {
+            protocol::read_message::<_, ClientMessage>(&mut io::stdin(), protocol::MAX_FRAME_SIZE)
+                .unwrap()
+        })
+        .join()
+        .unwrap();
+        assert_eq!(
+            next,
+            ClientMessage::Input {
+                data: b"buffered input".to_vec()
+            }
+        );
+    }
+
+    #[test]
+    fn input_origin_stdin_handles_share_buffer_with_upload_worker() {
+        use std::io::Write;
+        use std::process::{Command, Stdio};
+
+        let mut child = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "remote::host::tests::input_origin_stdin_child",
+                "--nocapture",
+            ])
+            .env("HERDR_INPUT_ORIGIN_STDIN_TEST", "1")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let mut frames = Vec::new();
+        protocol::write_message(
+            &mut frames,
+            &ClientMessage::TerminalHello {
+                version: protocol::PROTOCOL_VERSION,
+                cols: 80,
+                rows: 24,
+                cell_width_px: 0,
+                cell_height_px: 0,
+                pixel_mouse: false,
+            },
+        )
+        .unwrap();
+        protocol::write_message(
+            &mut frames,
+            &ClientMessage::Input {
+                data: b"buffered input".to_vec(),
+            },
+        )
+        .unwrap();
+        child.stdin.take().unwrap().write_all(&frames).unwrap();
+        let output = child.wait_with_output().unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert!(String::from_utf8_lossy(&output.stdout).contains("1 passed"));
+    }
+
+    #[test]
+    fn input_origin_bridge_overwrites_claim_and_preserves_buffered_frames() {
+        let mut hello: serde_json::Value = serde_json::from_str(include_str!(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/tests/fixtures/endpoint-hello-v1.json"
+        )))
+        .unwrap();
+        hello["origin"] = serde_json::json!({"via": "spoofed", "ssh_connection": "spoofed"});
+        hello["future_optional_field"] = serde_json::json!(42);
+        let mut frames = Vec::new();
+        protocol::write_message(
+            &mut frames,
+            &ClientMessage::EndpointControl {
+                kind: protocol::endpoint::ENDPOINT_HELLO_KIND.into(),
+                data: hello.to_string(),
+            },
+        )
+        .unwrap();
+        protocol::write_message(
+            &mut frames,
+            &ClientMessage::Input {
+                data: b"next".to_vec(),
+            },
+        )
+        .unwrap();
+        let mut reader = io::BufReader::new(io::Cursor::new(frames));
+        let ClientMessage::EndpointControl { data, .. } =
+            read_bridge_hello(&mut reader, Some("127.0.0.1 1234 100.1.2.3 22".into()))
+                .unwrap()
+                .unwrap()
+        else {
+            panic!("expected endpoint hello");
+        };
+        let hello: serde_json::Value = serde_json::from_str(&data).unwrap();
+        assert_eq!(
+            hello["origin"],
+            serde_json::json!({"via": "ssh_bridge", "ssh_connection": "127.0.0.1 1234 100.1.2.3 22"})
+        );
+        assert_eq!(hello["future_optional_field"], 42);
+        let next: ClientMessage =
+            protocol::read_message(&mut reader, protocol::MAX_FRAME_SIZE).unwrap();
+        assert_eq!(
+            next,
+            ClientMessage::Input {
+                data: b"next".to_vec()
+            }
+        );
+    }
+
+    #[test]
+    fn input_origin_bridge_preserves_legacy_hello_bytes() {
+        let hello = ClientMessage::TerminalHello {
+            version: protocol::PROTOCOL_VERSION,
+            cols: 80,
+            rows: 24,
+            cell_width_px: 0,
+            cell_height_px: 0,
+            pixel_mouse: false,
+        };
+        let mut original = Vec::new();
+        protocol::write_message(&mut original, &hello).unwrap();
+        let decoded = read_bridge_hello(&mut io::Cursor::new(&original), None)
+            .unwrap()
+            .unwrap();
+        let mut forwarded = Vec::new();
+        protocol::write_message(&mut forwarded, &decoded).unwrap();
+        assert_eq!(forwarded, original);
+    }
+
+    #[test]
+    fn input_origin_bridge_accepts_preparation_eof_but_rejects_truncated_frames() {
+        assert_eq!(read_bridge_hello(&mut io::empty(), None).unwrap(), None);
+        for truncated in [&b"\x01"[..], &b"\x01\x00\x00"[..], &b"\x01\x00\x00\x00"[..]] {
+            assert!(read_bridge_hello(&mut io::Cursor::new(truncated), None).is_err());
+        }
+    }
