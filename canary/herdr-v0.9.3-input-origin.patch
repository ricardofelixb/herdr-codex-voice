+fn read_bridge_hello(
+    reader: &mut impl io::Read,
+    ssh_connection: Option<String>,
+) -> io::Result<Option<crate::protocol::ClientMessage>> {
+    use crate::protocol::endpoint::{EndpointClientOrigin, ENDPOINT_HELLO_KIND};
+    use crate::protocol::{read_message, ClientMessage, MAX_FRAME_SIZE};
+
+    let mut first_byte = [0];
+    loop {
+        match reader.read(&mut first_byte) {
+            Ok(0) => return Ok(None),
+            Ok(_) => break,
+            Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error),
+        }
+    }
+    // Only EOF before the first byte is preparation. Partial frame prefixes or
+    // payloads still go through the strict framing decoder and remain errors.
+    let mut reader = io::Read::chain(io::Cursor::new(first_byte), reader);
+    let mut message: ClientMessage =
+        read_message(&mut reader, MAX_FRAME_SIZE).map_err(io::Error::other)?;
+    if let ClientMessage::EndpointControl { kind, data } = &mut message {
+        if kind == ENDPOINT_HELLO_KIND {
+            // Preserve unknown optional fields so a newer client can use this bridge.
+            let mut hello: serde_json::Value =
+                serde_json::from_str(data).map_err(io::Error::other)?;
+            let object = hello.as_object_mut().ok_or_else(|| {
+                io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "endpoint hello must be an object",
+                )
+            })?;
+            object.insert(
+                "origin".into(),
+                serde_json::to_value(EndpointClientOrigin {
+                    via: "ssh_bridge".into(),
+                    ssh_connection,
+                })
+                .map_err(io::Error::other)?,
+            );
+            *data = serde_json::to_string(&hello).map_err(io::Error::other)?;
+        }
+    }
+    Ok(Some(message))
+}
