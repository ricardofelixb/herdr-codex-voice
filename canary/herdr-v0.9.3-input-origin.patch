+        pixel_mouse: false,
+        direct_graphics: false,
+        endpoint_keybindings: false,
+        mouse_capture: false,
+        surface_active: true,
+        surface_reuse: false,
+        surface_delta: false,
+        surface_scroll: false,
+        writer,
+    });
+    input(&mut server, 3, &panes[0], key(ClientKeyKind::Press));
+    assert_eq!(
+        last_input(&mut server, &panes[0])
+            .unwrap()
+            .client
+            .unwrap()
+            .ssh_connection,
