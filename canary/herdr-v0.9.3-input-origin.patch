+        via: "ssh_bridge".into(),
+        ssh_connection: Some("127.0.0.1 3333 100.1.2.3 22".into()),
+    };
+    let (writer, _control, _render) = test_client_writer();
+    server.handle_server_event(ServerEvent::ClientShellConnected {
+        client_id: 3,
+        origin: Some(origin.clone()),
+        surface_cols: 80,
+        surface_rows: 24,
+        cell_width_px: 8,
